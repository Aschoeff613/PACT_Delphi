# --- Panel data: never commit -----------------------------------------------
# No panel data is tracked, de-identified or otherwise. Reviewer codes,
# timestamps and free-text comments are re-identifying in a panel this small,
# so ratings files stay out of version control entirely.
data/raw/*
!data/raw/.gitkeep
data/sample/
data/private/
*.csv
*.xlsx
*.xls

# --- Generated output --------------------------------------------------------
# Everything in output/ is reproducible from run_all.R. Committing it invites
# a stale table ending up in the manuscript. run_all.R creates the directories
# it needs, so nothing has to be tracked here.
output/
Rplots.pdf

# --- R -----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
.Renviron
*.Rcheck/
renv/library/
renv/staging/

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*~
.vscode/
.idea/
